#!/bin/sh

return_error() {
    echo "❌ Error: $1. Fix before committing."
    exit 1
}

echo "--- Running Pre-Commit Hooks ---"

# The project's virtual environment has black and isort; fall back to the system Python
PYTHON=".venv/Scripts/python"
[ -x "$PYTHON" ] || PYTHON=".venv/bin/python"
[ -x "$PYTHON" ] || PYTHON="python"

# Format the staged Python files, then stage the formatted versions.
# Note: this re-adds whole files, so a file staged only in part is committed in full.
STAGED_PY=$(git diff --name-only --cached --diff-filter=ACMR -- '*.py')
if [ -n "$STAGED_PY" ]; then
    echo "$STAGED_PY" | while IFS= read -r file; do
        "$PYTHON" -m isort --quiet "$file" || exit 1
        "$PYTHON" -m black --quiet "$file" || exit 1
        git add "$file"
    done || return_error "Formatting with isort and black failed"
    echo "✅ Staged Python files formatted with isort and black."
fi

"$PYTHON" tools/check_engine_imports.py || return_error "engine/ imports the game"

if [ -f "tools/line_counter.py" ]; then
    "$PYTHON" tools/line_counter.py || return_error "Line counting script failed"
else
    return_error "line_counter.py not found"
fi

if [ -f "README.md" ]; then
    git add README.md
    echo "✅ README.md updated and included in this commit."
fi

exit 0
